generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStudyStatus {
  draft
  published
}

enum CaseStudyTemplate {
  standard
  narrative
  dataHeavy
}

model CaseStudy {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  category      String
  year          Int
  summary       String
  description   String            @db.Text
  body          Json              @default("[]")
  template      CaseStudyTemplate @default(standard)
  coverImage    String?
  usersImpacted Int             @default(0)
  themeColor    String          @default("#F5C518")
  stats         Json
  tags          String[]
  github        String?
  liveDemo      String?
  featured      Boolean         @default(false)
  status        CaseStudyStatus @default(draft)
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum BlogPostStatus {
  draft
  published
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  excerpt         String         @default("") @db.Text
  category        String         @default("ai")
  tags            String[]
  emoji           String?
  coverImage      String?
  body            Json           @default("[]")
  status          BlogPostStatus @default(draft)
  publishedAt     DateTime?
  readMinutes     Int            @default(0)
  metaTitle       String?
  metaDescription String?
  externalUrl     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Experience {
  id          String    @id @default(cuid())
  role        String
  company     String
  startDate   DateTime
  endDate     DateTime?
  description String    @db.Text
  images      String[]
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  key   String @id
  value String
}
