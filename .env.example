# --- Existing AI twin ---
GEMINI_API_KEY=

# --- Admin CMS (never prefix with NEXT_PUBLIC_) ---
# Passphrase you type on /admin/login. Server-only.
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Supabase Postgres (Prisma) ---
# Local: direct URI (port 5432) is fine for prisma db push / seed.
# Vercel: use the Session/Transaction pooler (port 6543, IPv4). The direct
# db.[ref].supabase.co host is IPv6-only and admin login will 500 without it.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# --- Supabase Storage (cover uploads) ---
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: defaults to "covers"
SUPABASE_COVERS_BUCKET=covers
